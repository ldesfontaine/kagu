 # recompile depuis le tag avec ce paquet et refuse au moindre octet d'écart.
 # « sign » tient la clé, sous l'environnement protégé « release » : il ne
 # récupère pas le dépôt, n'installe rien, et ne fait que signer SHA256SUMS.
-# « publish » vérifie, atteste et publie, sans la clé.
+# « publish » vérifie, atteste et publie, sans la clé ; il publie aussi
+# install.sh, pris dans rebuild (sans npm), où il écrit MIN_VERSION. Le
+# script n'est pas dans SHA256SUMS : la signature ne couvre que les binaires.
 # Déclenché seulement par un tag vX.Y.Z poussé sur un commit de main. Une
 # version publiée ne se réécrit jamais : un job échoue si elle existe.
 # Actions épinglées par SHA, comme ci.yml.
@@ -178,6 +180,16 @@ jobs:
           sommes=$(sha256sum "$RUNNER_TEMP/dist-rebuild/SHA256SUMS" | cut -d' ' -f1)
           echo "sums_sha256=$sommes" >> "$GITHUB_OUTPUT"
 
+      # install.sh du tag, pris ici et pas dans build : npm n'a pas tourné
+      # sur ce runner. Ses clés sont celles de key.go
+      # (TestInstallScriptCarriesTheEmbeddedKeys, joué par build).
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: install-script
+          path: install.sh
+          retention-days: 1
+          if-no-files-found: error
+
   sign:
     needs: rebuild
     runs-on: ubuntu-24.04
@@ -253,6 +265,11 @@ jobs:
           name: signature
