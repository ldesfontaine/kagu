@@ -269,6 +286,19 @@ jobs:
           "$verificateur" release verify dist-release/opencloud-linux-amd64
           "$verificateur" release verify dist-release/opencloud-linux-arm64
 
+      # Après les contrôles des fichiers : install.sh n'est pas dans
+      # SHA256SUMS, il s'ajoute à la liste publiée.
+      - name: écrire MIN_VERSION dans install.sh
+        env:
+          TAG: ${{ github.ref_name }}
+        run: |
+          version="${TAG#v}"
+          sed "s/^MIN_VERSION=\"\"\$/MIN_VERSION=\"$version\"/" "$RUNNER_TEMP/script/install.sh" > dist-release/install.sh
+          if [ "$(grep -c '^MIN_VERSION=' dist-release/install.sh)" != 1 ] || ! grep -qx "MIN_VERSION=\"$version\"" dist-release/install.sh; then
+            echo "install.sh ne porte pas MIN_VERSION=\"$version\""
+            exit 1
+          fi
+
       - name: la version n'existe toujours pas
