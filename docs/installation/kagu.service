# /etc/systemd/system/kagu.service — le serveur Kagu.
[Unit]
Description=Kagu (serveur)
Documentation=https://github.com/ldesfontaine/kagu/blob/dev/docs/installation.md
# Docker d'abord : si `listen` vise l'IP du pont docker0, elle doit exister.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Ni root ni le groupe docker : le serveur ne lit rien de sa machine, c'est
# son agent (kagu-agent.service) qui le fait.
User=kagu
Group=kagu
# Le groupe de l'agent local, pour le seul usage de donner ce groupe à
# /run/kagu/agent.sock : l'agent de cette machine y ouvre la socket, et
# serve n'y admet que son uid. Le groupe doit exister avant le démarrage.
SupplementaryGroups=kagu-agent
ExecStart=/usr/local/bin/kagu serve -config /etc/kagu/config.toml
Restart=on-failure
RestartSec=5
# Crée /var/lib/kagu en 0700, propriété de kagu.
StateDirectory=kagu
StateDirectoryMode=0700
# Crée /run/kagu en 0755 à chaque démarrage, propriété de kagu :
# l'agent local y traverse pour joindre agent.sock (0660).
RuntimeDirectory=kagu
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# strict : tout est en lecture seule, sauf StateDirectory. Un state_dir
# ailleurs que /var/lib/kagu demande son ReadWritePaths.
ProtectSystem=strict
ProtectHome=read-only
# Le port 8080 n'exige aucune capacité.
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
